# Owner: S10. Golden-image tests.
#
#   fulmetry_add_golden_test(NAME <name>
#       COMMAND <cmd> [args...]          # must write OUTPUT (PPM or PNG); generator expressions allowed
#       OUTPUT <path>                    # image the command writes (relative: to the build dir of this file)
#       [GOLDEN <png>]                   # default: fixtures/golden/<name>.png
#       [THRESHOLD <0..255>]             # per-channel delta that counts a pixel as different (default 8)
#       [MAX_RMSE <x>]                   # default 4.0
#       [MAX_FRACTION <f>]               # max fraction of over-threshold pixels, 0..1 (default 0.002)
#       [EXPECT_MISMATCH]                # the test passes only if imgdiff reports a mismatch (exit 1)
#       [LABELS <labels...>])
#
# On failure the actual image, the golden and a diff image (red: over threshold, amber: below threshold,
# grey: equal) are copied to <build>/golden-diffs/<name>/, which CI uploads as an artifact.
# To regenerate goldens after an intended visual change: FULMETRY_UPDATE_GOLDENS=1 ctest --preset dev -L golden
include_guard(GLOBAL)

set(_FULMETRY_GOLDEN_RUNNER "${CMAKE_CURRENT_LIST_DIR}/RunGoldenTest.cmake")

function(_fulmetry_golden_quote out)
  set(q "")
  foreach(a IN LISTS ARGN)
    string(APPEND q " [==[${a}]==]")
  endforeach()
  set(${out} "${q}" PARENT_SCOPE)
endfunction()

function(fulmetry_add_golden_test)
  cmake_parse_arguments(PARSE_ARGV 0 G "EXPECT_MISMATCH" "NAME;OUTPUT;GOLDEN;THRESHOLD;MAX_RMSE;MAX_FRACTION"
                        "COMMAND;LABELS")
  if(NOT G_NAME OR NOT G_COMMAND OR NOT G_OUTPUT)
    message(FATAL_ERROR "fulmetry_add_golden_test: NAME, COMMAND and OUTPUT are required")
  endif()
  if(G_UNPARSED_ARGUMENTS)
    message(FATAL_ERROR "fulmetry_add_golden_test(${G_NAME}): unknown arguments ${G_UNPARSED_ARGUMENTS}")
  endif()
  if(NOT TARGET fulmetry_imgdiff)
    message(FATAL_ERROR "fulmetry_add_golden_test: fulmetry_imgdiff is not built (tools/imgdiff)")
  endif()
  if(NOT G_GOLDEN)
    set(G_GOLDEN "${PROJECT_SOURCE_DIR}/fixtures/golden/${G_NAME}.png")
  endif()
  foreach(opt THRESHOLD:8 MAX_RMSE:4.0 MAX_FRACTION:0.002)
    string(REPLACE ":" ";" kv "${opt}")
    list(GET kv 0 k)
    list(GET kv 1 v)
    if(NOT DEFINED G_${k})
      set(G_${k} "${v}")
    endif()
  endforeach()
  cmake_path(ABSOLUTE_PATH G_OUTPUT BASE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}" NORMALIZE)
  cmake_path(ABSOLUTE_PATH G_GOLDEN BASE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" NORMALIZE)

  _fulmetry_golden_quote(cmd ${G_COMMAND})
  set(script "${CMAKE_CURRENT_BINARY_DIR}/golden/${G_NAME}.cmake")
  set(expect FALSE)
  if(G_EXPECT_MISMATCH)
    set(expect TRUE)
  endif()
  file(GENERATE OUTPUT "${script}" CONTENT
"# Generated by fulmetry_add_golden_test(${G_NAME}). Do not edit.
set(GOLDEN_NAME [==[${G_NAME}]==])
set(GOLDEN_COMMAND${cmd})
set(GOLDEN_OUTPUT [==[${G_OUTPUT}]==])
set(GOLDEN_FILE [==[${G_GOLDEN}]==])
set(GOLDEN_IMGDIFF [==[$<TARGET_FILE:fulmetry_imgdiff>]==])
set(GOLDEN_LIMITS --threshold [==[${G_THRESHOLD}]==] --max-rmse [==[${G_MAX_RMSE}]==] --max-fraction [==[${G_MAX_FRACTION}]==])
set(GOLDEN_EXPECT_MISMATCH ${expect})
set(GOLDEN_WORK_DIR [==[${CMAKE_CURRENT_BINARY_DIR}/golden/${G_NAME}]==])
set(GOLDEN_FAIL_DIR [==[${CMAKE_BINARY_DIR}/golden-diffs/${G_NAME}]==])
include([==[${_FULMETRY_GOLDEN_RUNNER}]==])
")
  add_test(NAME "golden_${G_NAME}" COMMAND "${CMAKE_COMMAND}" -P "${script}")
  set_tests_properties("golden_${G_NAME}" PROPERTIES LABELS "golden;${G_LABELS}")
endfunction()
