<!-- Desk rover, simplified, Ø80 mm wheels. Generated by the worker in M4; hand-written for M0. -->
<mujoco model="desk-rover">
  <option timestep="0.002"/>
  <worldbody>
    <geom name="floor" type="plane" size="5 5 0.1"/>
    <geom name="rug" type="box" pos="0.9 0 0.004" size="0.6 1 0.004" friction="1.4 0.02 0.002"/>
    <body name="rover" pos="0 0 0.04">
      <freejoint/>
      <geom name="chassis" type="box" size="0.08 0.06 0.02" mass="0.25"/>
      <body name="wheel_l_body" pos="0 0.068 0">
        <joint name="wheel_l_joint" type="hinge" axis="0 1 0"/>
        <geom name="wheel_l" type="cylinder" size="0.04 0.007" euler="90 0 0" mass="0.018"/>
      </body>
      <body name="wheel_r_body" pos="0 -0.068 0">
        <joint name="wheel_r_joint" type="hinge" axis="0 1 0"/>
        <geom name="wheel_r" type="cylinder" size="0.04 0.007" euler="90 0 0" mass="0.018"/>
      </body>
      <geom name="caster" type="sphere" pos="-0.065 0 -0.032" size="0.008" mass="0.006"/>
    </body>
  </worldbody>
  <actuator>
    <velocity name="drive_l" joint="wheel_l_joint" kv="0.05"/>
    <velocity name="drive_r" joint="wheel_r_joint" kv="0.05"/>
  </actuator>
</mujoco>
