{
  "version": 6,
  "configurePresets": [
    { "name": "dev", "displayName": "Fakes only (fast)", "generator": "Ninja", "binaryDir": "build/dev",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "ci", "inherits": "dev", "binaryDir": "build/ci",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "CMAKE_COMPILE_WARNING_AS_ERROR": "ON" } },
    { "name": "ci-mujoco", "displayName": "CI: MuJoCo (MUJOCO_ROOT from env, see tools/deps.json)", "inherits": "ci",
      "binaryDir": "build/ci-mujoco",
      "cacheVariables": { "FULMETRY_WITH_MUJOCO": "ON", "MUJOCO_ROOT": "$env{MUJOCO_ROOT}" } },
    { "name": "ci-wicked", "displayName": "CI: Wicked Engine (WICKED_ROOT from env, see tools/deps.json)",
      "inherits": "ci", "binaryDir": "build/ci-wicked",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "FULMETRY_WITH_WICKED": "ON", "WICKED_ROOT": "$env{WICKED_ROOT}" } },
    { "name": "ci-raven", "displayName": "CI: Raven GUI (RAVEN_GUI_ROOT from env, see tools/deps.json)",
      "inherits": "ci", "binaryDir": "build/ci-raven",
      "cacheVariables": { "FULMETRY_WITH_RAVEN_GUI": "ON", "RAVEN_GUI_ROOT": "$env{RAVEN_GUI_ROOT}" } },
    { "name": "ci-m1", "displayName": "CI: workbench with the live Wicked stage in Raven GUI and MuJoCo for Simulate (WICKED_ROOT, RAVEN_GUI_ROOT, MUJOCO_ROOT from env)",
      "inherits": "ci", "binaryDir": "build/ci-m1",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "FULMETRY_WITH_WICKED": "ON", "WICKED_ROOT": "$env{WICKED_ROOT}",
                          "FULMETRY_WITH_RAVEN_GUI": "ON", "RAVEN_GUI_ROOT": "$env{RAVEN_GUI_ROOT}",
                          "FULMETRY_WITH_MUJOCO": "ON", "MUJOCO_ROOT": "$env{MUJOCO_ROOT}" } },
    { "name": "full", "inherits": "dev", "binaryDir": "build/full",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": { "FULMETRY_WITH_RAVEN_GUI": "ON", "FULMETRY_WITH_WICKED": "ON",
                          "FULMETRY_WITH_OCCT": "ON", "FULMETRY_WITH_MUJOCO": "ON" } }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" }, { "name": "ci", "configurePreset": "ci" },
    { "name": "ci-mujoco", "configurePreset": "ci-mujoco" }, { "name": "ci-wicked", "configurePreset": "ci-wicked" },
    { "name": "ci-raven", "configurePreset": "ci-raven" }, { "name": "ci-m1", "configurePreset": "ci-m1" }
  ],
  "testPresets": [
    { "name": "dev", "configurePreset": "dev", "output": { "outputOnFailure": true } },
    { "name": "ci", "configurePreset": "ci", "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "timeout": 300 } },
    { "name": "ci-mujoco", "inherits": "ci", "configurePreset": "ci-mujoco" },
    { "name": "ci-wicked", "inherits": "ci", "configurePreset": "ci-wicked" },
    { "name": "ci-raven", "inherits": "ci", "configurePreset": "ci-raven" },
    { "name": "ci-m1", "inherits": "ci", "configurePreset": "ci-m1" }
  ]
}
